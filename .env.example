# 环境变量配置模板
# 使用方法：复制本文件为 .env 并填入真实值
# cp .env.example .env

# 麦当劳 MCP Server 接入地址
MCD_MCP_URL=https://mcp.mcd.cn

# 麦当劳 MCP Token
# 申请路径：登录 https://open.mcd.cn/mcp → 控制台 → 激活 → 同意协议 → 复制 Token
MCD_MCP_TOKEN=YOUR_MCP_TOKEN

# 传输协议
MCD_MCP_PROTOCOL=streamablehttp

# 请求频率上限（官方限制 600 次/分钟，建议主动节流）
MCD_MCP_RATE_LIMIT=60

# 服务端口
PORT=3100